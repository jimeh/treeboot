{
  "name": "treeboot-workspace",
  "private": true,
  "workspaces": [
    "npm/treeboot",
    "npm/platforms/*"
  ],
  "type": "module",
  "scripts": {
    "build": "bun run npm:build",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "lint": "oxlint --type-aware --type-check",
    "lint:fix": "oxlint --type-aware --type-check --fix",
    "npm:build": "bun run npm/scripts/build.ts",
    "npm:pack": "bun run npm/scripts/package-release.ts",
    "npm:pack:check": "bun run npm/scripts/verify-package.ts",
    "npm:publish:check": "bun test npm/tests/publish.test.ts",
    "npm:test": "bun test npm/tests",
    "test": "bun run npm:test",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/bun": "^1.4.0",
    "@types/node": "^22.0.0",
    "oxfmt": "latest",
    "oxlint": "latest",
    "oxlint-tsgolint": "latest",
    "typescript": "^7.0.0"
  },
  "packageManager": "bun@1.4.0"
}
